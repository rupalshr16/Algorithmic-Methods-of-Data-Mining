    "def swap_case(s):\n",
    "    str=\"\"\n",
    "    for i in s:\n",
    "        if i.islower():\n",
    "            str+=i.upper()\n",
    "        elif i.isupper():\n",
    "            str+=i.lower()\n",
    "        else:\n",
    "            str+=i    \n",
    "        \n",
    "    return str\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    s = input()\n",
    "    result = swap_case(s)\n",
    "    print(result)"
