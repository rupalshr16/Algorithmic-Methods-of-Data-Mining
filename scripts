    "import textwrap\n",
    "\n",
    "def wrap(string, max_width):\n",
    "    result=\"\"\n",
    "    i=0\n",
    "    while i<len(string):\n",
    "        result+=string[i:i+max_width] + \"\\n\"\n",
    "        i+=max_width\n",
    "    return result.rstrip(\"\\n\")\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    string, max_width = input(), int(input())\n",
    "    result = wrap(string, max_width)\n",
    "    print(result)"
